.{
    .name = .cobra,
    .fingerprint = 0x171a4821ec9cd848,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .pflag = .{
            // 发布后取消注释下面两行，删除 .path 行
