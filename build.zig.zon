            // 然后 zig build 会自动提示正确的 hash
            // .url = "https://github.com/rebornwwp/zig-pflag/archive/refs/tags/v0.1.0.tar.gz",
            // .hash = "pflag-0.1.0-...",
            .path = "../zig-pflag",
        },
    },
    .paths = .{
        "build.zig",
        "src",
        "demo",
    },
}
